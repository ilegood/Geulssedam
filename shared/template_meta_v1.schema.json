{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Geulssedam Template Metadata v1",
  "type": "object",
  "required": [
    "service",
    "template_version",
    "preset_id",
    "total_pages",
    "total_chars",
    "spec",
    "pages"
  ],
  "properties": {
    "service": { "type": "string", "const": "Geulssedam" },
    "template_version": { "type": "string" },
    "preset_id": { "type": "string" },
    "preset_name": { "type": "string" },
    "total_pages": { "type": "integer", "minimum": 1 },
    "total_chars": { "type": "integer", "minimum": 1 },
    "pdf_file": { "type": ["string", "null"] },
    "spec": {
      "type": "object",
      "required": ["rows", "cols", "cell_size_px", "page_width_px", "page_height_px", "guide_ratios"],
      "properties": {
        "rows": { "type": "integer" },
        "cols": { "type": "integer" },
        "cells_per_page": { "type": "integer" },
        "cell_size_px": { "type": "integer" },
        "min_cell_size_px": { "type": "integer" },
        "recommended_cell_size_px": { "type": "integer" },
        "page_width_px": { "type": "integer" },
        "page_height_px": { "type": "integer" }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page_number", "total_pages", "group_id", "char_count", "cells"],
        "properties": {
          "page_number": { "type": "integer" },
          "total_pages": { "type": "integer" },
          "group_id": { "type": "string" },
          "group_name": { "type": "string" },
          "char_count": { "type": "integer" },
          "canvas_png": { "type": "string" },
          "guide_png": { "type": "string" },
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["index", "row", "col", "char", "codepoint", "x", "y", "width", "height", "guides"]
            }
          }
        }
      }
    }
  }
}
