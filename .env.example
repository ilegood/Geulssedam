# 공통 환경 변수 예시 (로컬 실행 시 .env로 복사해 사용)
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=5173

# 비동기 작업 백엔드: background (로컬 기본) | rq (Redis + RQ 워커)
TASK_BACKEND=rq
REDIS_URL=redis://redis:6379/0

# 저장소 및 보관 정책
STORAGE_DIR=/app/storage
RETENTION_DAYS=7
MAX_UPLOAD_MB=50

# 프런트엔드 API 주소
VITE_API_BASE_URL=http://localhost:8000
